# Copy this file to .env and fill in real values.
# Do not commit your .env with secrets.

# Dhan broker credentials (replaces Zerodha/Kite)
# Safe local verification defaults are used below. Before a live canary,
# set DHAN_ENV=live, DHAN_BASE_URL=https://api.dhan.co/v2, and
# USE_DHAN_MOCK=false with valid credentials.
# DHAN_USER_ID is the numeric Dhan account/client ID; it is not the API key.
TZ=Asia/Kolkata
DHAN_USER_ID=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_ENV=sandbox
DHAN_BASE_URL=https://sandbox.dhan.co/v2
DHAN_ENABLED=true
USE_DHAN_MOCK=true
DHAN_DEPTH_TIER=20

# Runtime safety flags
PRODUCTION_MODE=false
FAIL_CLOSED_ON_LIVE_ERROR=false
DISABLE_JWT_AUTH=false
ENABLE_LIVE_ORDERS=false
ALLOW_STREAM_TOKEN_QUERY=true

# Auth/session settings
JWT_SECRET=replace-with-long-random-secret

# Frontend origin used by backend CORS
FRONTEND_URL=http://localhost:5173

# Optional external integrations
OPENROUTER_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Middleware hardening toggles
TRUST_X_FORWARDED_FOR=false
EXPOSE_INTERNAL_ERRORS=false
